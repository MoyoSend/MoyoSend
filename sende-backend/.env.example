# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://sende:sende_dev_password@localhost:5432/sende?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_secret_never_commit_real_value
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Redis (queues / rate limit store in production)
REDIS_URL="redis://localhost:6379"

# KYC vendor (e.g. Sumsub) - sandbox credentials
KYC_PROVIDER=mock
KYC_API_KEY=replace_me
KYC_API_SECRET=replace_me
KYC_WEBHOOK_SIGNING_SECRET=replace_me

# FX rate provider
FX_PROVIDER=mock
FX_API_KEY=replace_me

# Payout aggregators
PAYOUT_PROVIDER_AFRICA=mock
PAYOUT_AFRICA_API_KEY=replace_me
PAYOUT_PROVIDER_SOUTH_ASIA=mock
PAYOUT_SOUTH_ASIA_API_KEY=replace_me

# Secrets / KMS (placeholders - use a real vault in production)
KMS_KEY_ID=replace_me
